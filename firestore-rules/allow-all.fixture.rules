// NOT A DEPLOYABLE RULESET. This permissive ruleset exists for exactly one
// purpose: proving the rules unit tests have teeth. Run
//   RULES_FILE=firestore-rules/allow-all.fixture.rules npm run test:rules
// and a large majority of firestore-rules/**/*.test.ts MUST fail. A rules
// suite that passes against this file is asserting nothing.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
